# =============================================================================
# SKYCON — Autonomous Drone Rescue System (Raspberry Pi 4 Model B)
# Configuration Variables
# =============================================================================

# Central Cloud API Base (PythonAnywhere)
VITE_CLOUD_API_BASE=https://teamskycon.pythonanywhere.com

# Local Raspberry Pi 4 Agent WebSocket (used when running locally over HTTP on port 8443)
VITE_PI_WS_URL=ws://127.0.0.1:8443/ws

# Field Hotspot WiFi SSID
VITE_WIFI_SSID=drone123
