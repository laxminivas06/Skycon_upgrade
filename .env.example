# SKYCON Drone System — Environment Configuration
# Copy this file to .env and adjust values for your environment

# Server & Hosting Configuration
PORT=8443
SKYCON_HOST=0.0.0.0
SKYCON_ENV=production
SKYCON_DEBUG=False
SKYCON_SECRET_KEY=saeindia_skycon_production_secret_2026

# MAVLink Autopilot Serial Port (Raspberry Pi 4 Model B)
# TELEM1 UART on Pi 4 is /dev/ttyAMA0 or /dev/serial0
MAVLINK_PORT=/dev/ttyAMA0
MAVLINK_BAUD=921600

# Data & Logging Storage Paths
SKYCON_DATA_DIR=backend/data
SKYCON_LOG_DIR=backend/logs

# Competition Parameters (ADDC 2026)
COMPETITION_TIME_LIMIT_S=300
MAX_FENCE_ALTITUDE_M=25.0
DEFAULT_FENCE_RADIUS_M=50.0
QR_REGEX_PATTERN=^\d{2}$
